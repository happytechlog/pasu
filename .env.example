# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgres://monitor:monitor@localhost:5432/monitor

# Better Auth (stage 2). Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP — local defaults point to Mailpit (http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Uptime Monitor <alerts@localhost>"

# Check retention (default 30 days) is set by admins at /settings/general.

# Docker full stack only (docker compose --profile app). Defaults use the mailpit service.
# COMPOSE_SMTP_HOST=smtp.example.com
# COMPOSE_SMTP_PORT=587
# WEB_PORT=3000
