# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches docker-compose.yml defaults)
DATABASE_URL=postgres://monitor:monitor@localhost:5432/monitor

# Better Auth (stage 2). Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP — local defaults point to Mailpit (http://localhost:8025).
# In the Docker stack use SMTP_HOST=mailpit for Mailpit ("localhost" is the container itself).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pasu Monitor <alerts@localhost>"

# Check retention (default 30 days) is set by admins at /settings/general.
# WEB_PORT=3000
