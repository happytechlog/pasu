# Copy to .env and fill in. Never commit .env.

# PostgreSQL (matches the defaults of the development docker-compose.yml)
DATABASE_URL=postgres://monitor:monitor@localhost:5432/monitor
# Production (docker-compose.prod.yml): REQUIRED, used for the db service and the apps' DATABASE_URL.
# Use URL-safe characters, e.g. `openssl rand -hex 24`. Only applied when the DB volume is first created.
# In development it is optional (default "monitor"); if you set it, also change DATABASE_URL above,
# and note an existing dev volume keeps its old password.
# POSTGRES_PASSWORD=

# Better Auth (stage 2). Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# SMTP — local defaults point to Mailpit (http://localhost:8025).
# In the Docker stack use SMTP_HOST=mailpit for Mailpit ("localhost" is the container itself).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Pasu Monitor <alerts@localhost>"

# Private-network monitoring. Monitors may only target public addresses unless an admin
# saves them AND the address is inside this comma-separated CIDR list. Empty = public only.
# Link-local/cloud-metadata addresses (169.254.0.0/16, ...) are never allowed.
# Keep it narrow: list the subnets you monitor, not all of 10.0.0.0/8. In the Docker stack
# the db/mailpit services live in 172.16.0.0/12, so don't allow that range unless you must.
# For the dev check targets (/api/test/*) use: MONITOR_ALLOWED_NETWORKS=127.0.0.0/8,::1/128
MONITOR_ALLOWED_NETWORKS=

# Check retention (default 30 days) is set by admins at /settings/general.

# Host ports. Only the server side changes; inside the containers the web app stays on 3000 and
# Postgres on 5432, so do not edit the Dockerfile to move them.
# Server port for the web app (point nginx's proxy_pass here).
# WEB_PORT=3000
# Server address for the web app. Dev compose: unset = all interfaces. Prod compose: default 127.0.0.1.
# WEB_BIND=127.0.0.1
# Dev compose only, always on 127.0.0.1. If you change it, also change the port in DATABASE_URL above.
# DB_PORT=5432
